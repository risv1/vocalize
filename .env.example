# Copy to server/.env and adjust. Loaded by pydantic-settings.

HOST=127.0.0.1
PORT=8420
CORS_ORIGINS=["*"]

# Torch device for local models (Kokoro TTS, HF LLM/TTS pipelines):
# auto | cuda | mps | cpu. "auto" picks CUDA, then Apple Silicon MPS, then CPU.
DEVICE=auto

# --- TTS ---
# Only "huggingface" is implemented. The default repo (Kokoro) is loaded
# through the official `kokoro` package, which pulls weights from the HF
# Hub itself on first use — no manual download step needed.
TTS_PROVIDER=huggingface
TTS_MODEL_REPO=hexgrad/Kokoro-82M
TTS_DEFAULT_VOICE=af_heart
TTS_DEFAULT_SPEED=1.0

# --- LLM ---
# llm_provider: ollama | vllm | huggingface | anthropic | openai | gemini
LLM_PROVIDER=ollama

# Each provider has its own model setting below, since e.g. "qwen2.5:3b"
# (an Ollama tag) means nothing to Anthropic's API. The extension can also
# override the model per-request without touching this file.

# If the server runs on bare metal / uv run, http://localhost:11434 is right.
# If the server runs in Docker (docker-compose / make docker-up), "localhost"
# means the container itself — use http://host.docker.internal:11434 instead
# to reach Ollama running on the host machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Same Docker-vs-bare-metal note applies to vLLM.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=

HUGGINGFACE_MODEL_REPO=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Crawl ---
CRAWL_MAX_PAGES=5
CRAWL_TIMEOUT_SECONDS=10.0
CRAWL_USER_AGENT=VocalizeBot/0.1 (+https://github.com/)

# --- Conversation history ---
# SQLite file at {DATA_DIR}/conversations.db, organized by page URL.
DATA_DIR=data
